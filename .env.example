NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# Server-only. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Optional. Defaults to gpt-5.6-luna for a cost-efficient storefront assistant.
OPENAI_ASSISTANT_MODEL=gpt-5.6-luna

# Optional but recommended in production. Vercel Cron sends this as Bearer auth.
CRON_SECRET=
